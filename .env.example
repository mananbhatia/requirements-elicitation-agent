# Copy this file to `.env` and fill in your keys.
# Only the first two are required to run the app locally.

ANTHROPIC_API_KEY=your-anthropic-key
VOYAGE_API_KEY=your-voyage-key

# Optional: override the default embedding model (default: voyage-3.5-lite)
# EMBEDDING_MODEL=voyage-3.5-lite

# Optional — hosted deployment only. Leave unset to run locally (logs go to ./logs).
# Write session logs to a Databricks Unity Catalog Volume via the Files API:
# DATABRICKS_TOKEN=your-token
# DATABRICKS_BASE_URL=https://your-workspace.azuredatabricks.net
# SESSION_LOG_DIR=/Volumes/your-catalog/default/logs/sessions
